{
    # Configuración global
    frankenphp
    order php_server before file_server
}

:{$PORT:8080}

# Definimos la raíz fuera de cualquier bloque
root * public/

# Procesamos PHP primero
php_server {
    env DATABASE_URL {env.DATABASE_URL}
}

# Si no es un archivo PHP ni un archivo real, enviamos al index.php
@not_file {
    not file {path}
    not path *.php
}
rewrite @not_file /index.php?{query}

# Servimos archivos estáticos (CSS, JS)
file_server